# Copy to .env.local for development. Set these separately in Vercel.
# Never commit .env.local or real credentials.
# Supabase Auth in the company's Supabase project (the one holding schema "accounts").
# Server-only: the browser never receives these. The secret key sets passwords and
# reads "has a password"; it never leaves the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Google sign-in is built but parked; leave unset (off). "on" turns it on.
STUDIO_GOOGLE_SIGNIN=
# Optional: the Studio address sign-in links return to (https, no path), one per
# environment, e.g. https://studio.example.com. Unset: the Vercel production or
# branch address (locally, the address of the request). It and "<it>/**" must be
# in Supabase Auth's redirect URLs (README, "Where sign-in links return to").
STUDIO_PUBLIC_ORIGIN=

# Supabase Postgres, schema "studio", as the studio_app role (docs/supabase-setup.sql).
# Production: the main project. Preview: the separate staging project.
# Running studio: transaction pooler, port 6543.
DATABASE_URL=
# Migrations only (npm run db:migrate): session pooler or direct connection, port 5432.
DATABASE_URL_DIRECT=
# Optional: connections per serverless instance (default 2).
DATABASE_POOL_MAX=

# Private AWS S3 bucket and its own IAM user (docs/s3-setup.md). One bucket per environment.
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave unset for AWS. Only for a local S3-compatible stand-in during development:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Exactly 64 hex characters (32 bytes), e.g. `openssl rand -hex 32`.
# Never change it once keys are saved.
KEY_ENCRYPTION_SECRET=

# Optional server default; normally connect providers in the studio interface.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-5-mini

# Configurators come from the master list (accounts.cars, narrowed per company by
# accounts.configurator_access). accounts.cars stores paths; this is the origin they
# are joined to (https only, no path). Example: https://configurator.example.com
CONFIGURATOR_ORIGIN=
