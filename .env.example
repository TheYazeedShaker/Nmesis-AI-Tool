# Copy to .env.local for development. Set these separately in Vercel.
# Never commit .env.local or real credentials.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STUDIO_ALLOWED_EMAILS=

# Supabase Postgres, schema "studio", as the studio_app role (docs/supabase-setup.sql).
# Production: the main project. Preview: the separate staging project.
# Running studio: transaction pooler, port 6543.
DATABASE_URL=
# Migrations only (npm run db:migrate): session pooler or direct connection, port 5432.
DATABASE_URL_DIRECT=
# Optional: connections per serverless instance (default 2).
DATABASE_POOL_MAX=

# Private AWS S3 bucket and its own IAM user (docs/s3-setup.md). One bucket per environment.
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave unset for AWS. Only for a local S3-compatible stand-in during development:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# A second random secret, at least 32 characters. Keep it stable after saving keys.
KEY_ENCRYPTION_SECRET=

# Optional shared account. Comma-separated guest emails; all must also be allowed users.
SHARED_OPENAI_OWNER_EMAIL=
SHARED_OPENAI_GUEST_EMAILS=

# Optional server default; normally connect providers in the studio interface.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-5-mini

# Configurator presets shown in the picker. Server-only: served to signed-in users by
# /api/configurators, never built into the browser bundle. Takes effect on the next deployment.
# JSON array of {"id","name","url"}; https URLs only. Keep real brand names/URLs here, not in source.
# The capture-template flow expects the first preset's id to be "s08".
# Example: [{"id":"s08","name":"Demo SUV","url":"https://configurator.example.com/suv/"}]
CONFIGURATOR_PRESETS=
